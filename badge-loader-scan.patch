diff -ruN pa/badge-loader/scan-handler.js pb/badge-loader/scan-handler.js
--- pa/badge-loader/scan-handler.js	1970-01-01 00:00:00.000000000 +0000
+++ pb/badge-loader/scan-handler.js	2026-11-06 12:39:31.482298878 +0000
@@ -0,0 +1,87 @@
+'use strict';
+/**
+ * scan-handler.js
+ * Turns a decrypted QR payload (from the CoBang inbox) into a directory lookup.
+ *
+ * Payload may be:
+ *   - a badge QR starting with "@CONCAT" -> replayed to the site as a keyboard-scanner scan
+ *   - a profile link on the connected site (…/housekeeping/cashier/<id>) -> loaded directly
+ *   - anything else (an ID, a name, a code)                              -> used as a search term
+ *
+ * Exactly one match loads the profile; several matches are handed to the search dropdown.
+ * Dependencies are injected so this can be unit-tested without Electron or Playwright.
+ */
+
+const MAX_PAYLOAD = 512;
+const PROFILE_PREFIX = '/housekeeping/cashier/';
+const BADGE_PREFIX = '@CONCAT'; // what the site's own scanner listener recognises
+
+function createScanHandler({ bridge, loadProfile, notify }) {
+  let queue = Promise.resolve();
+
+  function profileHref(text) {
+    if (text.startsWith(PROFILE_PREFIX)) return text;
+    let url;
+    try { url = new URL(text); } catch { return null; }
+    let base;
+    try { base = new URL(bridge.getBaseUrl()); } catch { return null; } // not logged in yet
+    if (url.origin !== base.origin) return null;
+    return url.pathname.startsWith(PROFILE_PREFIX) ? url.pathname : null;
+  }
+
+  async function resolve(raw) {
+    const text = String(raw ?? '').trim();
+    // QR content is untrusted input.
+    if (!text || text.length > MAX_PAYLOAD || /[\u0000-\u001f\u007f]/.test(text)) {
+      notify({ state: 'error', message: 'Scan ignored: unexpected QR content.' });
+      return;
+    }
+    notify({ state: 'searching' });
+    try {
+      if (text.startsWith(BADGE_PREFIX)) {
+        // Badge QR: hand it to the site's own scanner handling (see playwright.js scanBadge).
+        const out = await bridge.scanBadge(text);
+        if (out.kind === 'profile') {
+          await loadProfile(out.href);
+          notify({ state: 'selected' });
+        } else if (out.kind === 'results' && out.results.length === 1) {
+          await loadProfile(out.results[0].href);
+          notify({ state: 'selected' });
+        } else if (out.kind === 'results') {
+          notify({ state: 'multiple', count: out.results.length });
+        } else {
+          notify({ state: 'none' });
+        }
+        return;
+      }
+      const href = profileHref(text);
+      if (href) {
+        await loadProfile(href);
+        notify({ state: 'selected' });
+        return;
+      }
+      const results = await bridge.searchUsers(text);
+      if (results.length === 1) {
+        const [user] = results;
+        await loadProfile(user.href);
+        notify({ state: 'selected', name: [user.firstName, user.lastName].filter(Boolean).join(' ') });
+      } else if (results.length > 1) {
+        notify({ state: 'multiple', term: text, count: results.length });
+      } else {
+        notify({ state: 'none' });
+      }
+    } catch (err) {
+      notify({ state: 'error', message: err?.message || 'Scan lookup failed.' });
+    }
+  }
+
+  // Scans are handled one at a time, in order.
+  function handle(raw) {
+    queue = queue.then(() => resolve(raw));
+    return queue;
+  }
+
+  return { handle };
+}
+
+module.exports = { createScanHandler, MAX_PAYLOAD };
diff -ruN pa/badge-loader/scan-ui.js pb/badge-loader/scan-ui.js
--- pa/badge-loader/scan-ui.js	1970-01-01 00:00:00.000000000 +0000
