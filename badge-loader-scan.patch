@@ -0,0 +1,39 @@
+/**
+ * scan-ui.js
+ * Shows CoBang scan results. Single matches arrive via the normal registration
+ * panel; several matches are shown in the existing search dropdown.
+ */
+(function () {
+  'use strict';
+
+  const status = document.getElementById('scan-status');
+  const searchInput = document.getElementById('header-search-input');
+  if (!status || !searchInput || !window.scanAPI) return;
+
+  function say(text) { status.textContent = text; }
+
+  window.scanAPI.onEvent((event) => {
+    switch (event?.state) {
+      case 'searching':
+        say('Scan received, looking up…');
+        break;
+      case 'selected':
+        say('Scan matched, profile loaded.');
+        if (typeof event.name === 'string') searchInput.value = event.name;
+        break;
+      case 'multiple':
+        say(`Scan matched ${Number(event.count) || 'several'} users. Pick one.`);
+        if (typeof event.term === 'string') {
+          // Reuse the existing search UI: it runs the same search and lists the matches.
+          searchInput.value = event.term;
+          searchInput.dispatchEvent(new Event('input', { bubbles: true }));
+        }
+        break;
+      case 'none':
+        say('Scan matched no users.');
+        break;
+      default:
+        say(typeof event?.message === 'string' ? event.message : 'Scan failed.');
+    }
+  });
+})();
