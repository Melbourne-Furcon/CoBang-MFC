diff -ruN pa/badge-loader/test/scan-handler.test.js pb/badge-loader/test/scan-handler.test.js
--- pa/badge-loader/test/scan-handler.test.js	1970-01-01 00:00:00.000000000 +0000
+++ pb/badge-loader/test/scan-handler.test.js	2026-11-06 12:39:31.482347781 +0000
@@ -0,0 +1,139 @@
+// Run with: npm run test:unit  (node --test)
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const { createScanHandler } = require('../scan-handler.js');
+
+function setup({ results = [], baseUrl = 'https://melbourne.concat.app', searchImpl } = {}) {
+  const calls = { search: [], load: [], events: [] };
+  const bridge = {
+    getBaseUrl: () => { if (!baseUrl) throw new Error('No base URL set.'); return baseUrl; },
+    searchUsers: searchImpl ?? (async (term) => { calls.search.push(term); return results; }),
+  };
+  const handler = createScanHandler({
+    bridge,
+    loadProfile: async (href) => { calls.load.push(href); },
+    notify: (e) => calls.events.push(e),
+  });
+  return { handler, calls };
+}
+const states = (calls) => calls.events.map((e) => e.state);
+
+test('single match loads the profile', async () => {
+  const { handler, calls } = setup({ results: [{ href: '/housekeeping/cashier/42', firstName: 'Pepsi', lastName: 'Man' }] });
+  await handler.handle('13');
+  assert.deepEqual(calls.search, ['13']);
+  assert.deepEqual(calls.load, ['/housekeeping/cashier/42']);
+  assert.deepEqual(states(calls), ['searching', 'selected']);
+  assert.equal(calls.events[1].name, 'Pepsi Man');
+});
+
+test('several matches go to the dropdown, nothing is auto-loaded', async () => {
+  const { handler, calls } = setup({ results: [{ href: '/housekeeping/cashier/1' }, { href: '/housekeeping/cashier/2' }] });
+  await handler.handle('Sam');
+  assert.deepEqual(calls.load, []);
+  assert.deepEqual(calls.events.at(-1), { state: 'multiple', term: 'Sam', count: 2 });
+});
+
+test('no match', async () => {
+  const { handler, calls } = setup({ results: [] });
+  await handler.handle('nobody');
+  assert.deepEqual(states(calls), ['searching', 'none']);
+});
+
+test('profile link on the connected site is loaded directly, without a search', async () => {
+  const { handler, calls } = setup();
+  await handler.handle('https://melbourne.concat.app/housekeeping/cashier/77?x=1');
+  assert.deepEqual(calls.search, []);
+  assert.deepEqual(calls.load, ['/housekeeping/cashier/77']);
+});
+
+test('relative profile path is loaded directly', async () => {
+  const { handler, calls } = setup();
+  await handler.handle('/housekeeping/cashier/9');
+  assert.deepEqual(calls.load, ['/housekeeping/cashier/9']);
+});
+
+test('link to another site is not followed; it is only a search term', async () => {
+  const { handler, calls } = setup({ results: [] });
+  await handler.handle('https://evil.example/housekeeping/cashier/1');
+  assert.deepEqual(calls.load, []);
+  assert.equal(calls.search.length, 1);
+});
+
+test('control characters and oversized payloads are rejected before any lookup', async () => {
+  const { handler, calls } = setup();
+  await handler.handle('abc\u0000def');
+  await handler.handle('x'.repeat(513));
+  await handler.handle('   ');
+  assert.deepEqual(calls.search, []);
+  assert.deepEqual(states(calls), ['error', 'error', 'error']);
+});
+
+test('lookup errors are reported and do not block later scans', async () => {
+  let n = 0;
+  const { handler, calls } = setup({
+    searchImpl: async () => { if (n++ === 0) throw new Error('Session expired — please log in again.'); return []; },
+  });
+  await handler.handle('1');
+  await handler.handle('2');
+  assert.deepEqual(calls.events.map((e) => e.state), ['searching', 'error', 'searching', 'none']);
+  assert.match(calls.events[1].message, /Session expired/);
+});
+
+test('scans are processed one at a time, in order', async () => {
+  const order = [];
+  const { handler } = setup({
+    searchImpl: async (term) => { order.push(`start ${term}`); await new Promise((r) => setTimeout(r, 20)); order.push(`end ${term}`); return []; },
+  });
+  await Promise.all([handler.handle('a'), handler.handle('b')]);
+  assert.deepEqual(order, ['start a', 'end a', 'start b', 'end b']);
+});
+
+// ── badge QR ("@CONCAT;UUID…") ──────────────────────────────────────────────
+function setupBadge(scanImpl) {
+  const calls = { scan: [], load: [], search: [], events: [] };
+  const handler = createScanHandler({
+    bridge: {
+      getBaseUrl: () => 'https://melbourne.concat.app',
+      searchUsers: async (t) => { calls.search.push(t); return []; },
+      scanBadge: async (t) => { calls.scan.push(t); return scanImpl(t); },
+    },
+    loadProfile: async (h) => { calls.load.push(h); },
+    notify: (e) => calls.events.push(e),
+  });
+  return { handler, calls };
+}
+const BADGE = '@CONCAT;UUID00000000-0000-4000-8000-000000000000';
+
+test('badge scan opening a profile loads it, and never uses the plain text search', async () => {
+  const { handler, calls } = setupBadge(async () => ({ kind: 'profile', href: '/housekeeping/cashier/42' }));
+  await handler.handle(BADGE);
+  assert.deepEqual(calls.scan, [BADGE]);
+  assert.deepEqual(calls.search, []);
+  assert.deepEqual(calls.load, ['/housekeeping/cashier/42']);
+  assert.deepEqual(states({ events: calls.events }), ['searching', 'selected']);
+});
+
+test('badge scan with no match', async () => {
+  const { handler, calls } = setupBadge(async () => ({ kind: 'none' }));
+  await handler.handle(BADGE);
+  assert.equal(calls.events.at(-1).state, 'none');
+});
+
+test('badge scan showing a single result row loads it', async () => {
+  const { handler, calls } = setupBadge(async () => ({ kind: 'results', results: [{ href: '/housekeeping/cashier/7' }] }));
+  await handler.handle(BADGE);
+  assert.deepEqual(calls.load, ['/housekeeping/cashier/7']);
+});
+
+test('badge scan with several rows reports a count and does not touch the search box', async () => {
+  const { handler, calls } = setupBadge(async () => ({ kind: 'results', results: [{ href: 'a' }, { href: 'b' }] }));
+  await handler.handle(BADGE);
+  assert.deepEqual(calls.events.at(-1), { state: 'multiple', count: 2 });
+});
+
+test('badge scan errors (e.g. site did not react) are reported', async () => {
+  const { handler, calls } = setupBadge(async () => { throw new Error('The site did not react to the scan.'); });
+  await handler.handle(BADGE);
+  assert.match(calls.events.at(-1).message, /did not react/);
+});
