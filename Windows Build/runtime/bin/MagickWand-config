#!/bin/sh
#
# Configure options script for re-calling MagickWand compilation options
# required to use the MagickWand library.
#

prefix=/ucrt64
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
pkgconfigdir=${libdir}/pkgconfig
export PKG_CONFIG_LIBDIR="${pkgconfigdir}"

usage="\
Usage: MagickWand-config [--cflags] [--cppflags] [--exec-prefix] [--ldflags] [--libs] [--prefix] [--version]"

if test $# -eq 0; then
      echo "${usage}" 1>&2
      echo "Example: gcc \`MagickWand-config --cflags --cppflags\` -o wand wand.c \`MagickWand-config --ldflags --libs\`" 1>&2
      exit 1
fi

while test $# -gt 0; do
  case "$1" in
    -*=*) optarg=`echo "$1" | sed 's/[-_a-zA-Z0-9]*=//'` ;;
    *) optarg= ;;
  esac
  case $1 in
    --prefix=*)
      prefix=$optarg
      ;;
    --prefix)
      echo $prefix
      ;;
    --exec-prefix=*)
      exec_prefix=$optarg
      ;;
    --exec-prefix)
      echo $exec_prefix
      ;;
    --version)
      echo '7.1.2-35 Q16 HDRI'
      ;;
    --cc)
      echo 'gcc'
      ;;
    --cflags)
      /ucrt64/bin/x86_64-w64-mingw32-pkg-config --cflags MagickWand-7.Q16HDRI
      ;;
    --cxx)
      echo 'g++ -std=gnu++11 -std=gnu++11'
      ;;
    --cxxflags)
      /ucrt64/bin/x86_64-w64-mingw32-pkg-config --cflags MagickWand-7.Q16HDRI
      ;;
    --cppflags)
      /ucrt64/bin/x86_64-w64-mingw32-pkg-config --cflags MagickWand-7.Q16HDRI
      ;;
    --ldflags)
      /ucrt64/bin/x86_64-w64-mingw32-pkg-config --libs MagickWand-7.Q16HDRI
      ;;
    --libs)
      /ucrt64/bin/x86_64-w64-mingw32-pkg-config --libs MagickWand-7.Q16HDRI
      ;;
    *)
      echo "${usage}" 1>&2
      exit 1
      ;;
  esac
  shift
done

