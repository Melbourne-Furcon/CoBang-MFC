from pathlib import Path
import locale
import os
import signal
import sys


VERSION = '2.11.1'
script_dir = os.path.dirname(os.path.abspath(__file__))
pkgdatadir = os.path.join(script_dir, '..', 'share', 'cobang')
localedir = os.path.join(script_dir, '..', 'share', 'locale')


sys.path.insert(1, pkgdatadir)
signal.signal(signal.SIGINT, signal.SIG_DFL)
if hasattr(locale, 'bindtextdomain'):
    locale.bindtextdomain('cobang', localedir)
    locale.textdomain('cobang')
else:  # Windows builds of Python
    import gettext

    gettext.bindtextdomain('cobang', localedir)
    gettext.textdomain('cobang')

if __name__ == '__main__':
    from gi.repository import Gio

    resource = Gio.Resource.load(os.path.join(pkgdatadir, 'cobang.gresource'))
    resource._register()

    from cobang import app

    sys.exit(app.main(VERSION))
